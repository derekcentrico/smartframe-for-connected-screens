# SmartFrame environment variables
# Copy this file to .env and edit the values for your setup.

# ---------------------
# Core paths & timing
# ---------------------
MEDIA_BASE=/media/smartframes
CACHE_BASE=/cache
SLIDE_INTERVAL=25

# ---------------------
# Weather (Open-Meteo)
# ---------------------
WEATHER_LAT=40.71
WEATHER_LON=-74.01
WEATHER_TZ=America/New_York
WEATHER_OFFSET_C=0.0

# ---------------------
# Home Assistant
# ---------------------
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_token_here

# ---------------------
# Video handling
# ---------------------
MAX_VIDEO_MB=12
ENABLE_VIDEOS=1

# ---------------------
# HEIC support
# ---------------------
ENABLE_HEIC=1

# ---------------------
# Face-aware cropping
# ---------------------
ENABLE_FACES=1
FAVORITE_MIN_PHOTOS=15
FACE_SCAN_INTERVAL=300

# ---------------------
# Upload settings
# ---------------------
MAX_UPLOAD_MB=200
UPLOAD_AUTH_ENABLED=0
UPLOAD_USERNAME=admin
UPLOAD_PASSWORD=changeme

# ---------------------
# Per-frame HA entities
# Repeat this pattern for each frame name (UPSTAIRS, BASEMENT, etc.)
# ---------------------

# Upstairs frame
HA_UPSTAIRS_MOTION_ENTITY=input_boolean.frame_upstairs_display_on
HA_UPSTAIRS_STATUS_ENTITY_1=sensor.upstairs_temperature
HA_UPSTAIRS_STATUS_LABEL_1=Upstairs
HA_UPSTAIRS_STATUS_ENTITY_2=sensor.energy_usage_summary
HA_UPSTAIRS_STATUS_LABEL_2=Energy
HA_UPSTAIRS_STATUS_ENTITY_3=sensor.home_occupancy_summary
HA_UPSTAIRS_STATUS_LABEL_3=Home

# Basement frame
HA_BASEMENT_MOTION_ENTITY=input_boolean.frame_basement_display_on
HA_BASEMENT_STATUS_ENTITY_1=sensor.basement_temperature
HA_BASEMENT_STATUS_LABEL_1=Basement
HA_BASEMENT_STATUS_ENTITY_2=sensor.energy_usage_summary
HA_BASEMENT_STATUS_LABEL_2=Energy
HA_BASEMENT_STATUS_ENTITY_3=sensor.home_occupancy_summary
HA_BASEMENT_STATUS_LABEL_3=Home
